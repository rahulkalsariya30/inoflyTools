# =============================================================
# CRITICAL: Private keys must NEVER be committed
# =============================================================
pki/manufacturer/private/
pki/cb/private/
# Derived per-drone signing keys (e.g. SITL_*_signing_key.txt) — key material,
# not under a private/ dir so the rules above don't catch them.
pki/manufacturer/signing_keys/

# Block private key file formats — scoped to avoid catching public keys
*.key
*.p12
*.pfx

# Block .pem ONLY in private directories (not globally)
pki/**/private/**/*.pem

# Public keys and certificates ARE safe to commit
# (no exclusion needed — they're not ignored)

# =============================================================
# Python
# =============================================================
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
dist/
build/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# =============================================================
# PX4 build artifacts (build inside WSL, not tracked here)
# =============================================================
firmware/build/
build_artifacts/
*.px4
*.elf
*.bin
*.hex
*.map

# =============================================================
# QGroundControl fork (nested git repo, has its own remote)
# =============================================================
qgroundcontrol/

# =============================================================
# Signed firmware bundles (generated artifacts, not source)
# =============================================================
*.sfb
*.signed
*.fwbundle
*.sig

# =============================================================
# Generated compliance / test artifacts
# =============================================================
Docs/compliance_report.json
Docs/compliance_report.txt
Docs/audit_log.bin
Docs/audit_log.sig
.attacker_fixtures/
.fixture_workdir/
.param_fixtures/
# FM tracking sheet — generated by tools/fill_fm_xlsx.py (regenerate, don't track)
Docs/Secure Flight Module (FM) and Tracking mechanism.xlsx

# =============================================================
# Third-party reference / confidential docs (do not commit)
# =============================================================
Docs/*.pdf
Docs/Security Requirements.docx

# =============================================================
# Local / personal helper scripts (not part of the project)
# =============================================================
tools/cleanup_c_drive.ps1

# =============================================================
# Bench session build artifacts (release/ is the on-disk staging
# dir for hardware bring-up — ELF/PX4/fwbundle/bin caught by globs
# above, plus per-session manifest.json/signed.json/sd/ that aren't)
# =============================================================
release/

# =============================================================
# Local editor config
# =============================================================
.local-tooling/

# =============================================================
# Secrets and environment
# =============================================================
.env
*.secret
secrets/
**/Token.txt
**/token.txt

# =============================================================
# OS / Editor
# =============================================================
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo
*~

# =============================================================
# Logs and test output
# =============================================================
*.log
tests/output/
